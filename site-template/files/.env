# Where this local copy runs. Each host is its own port on localhost, so another site
# or a second checkout of this one needs other ports: set them here or in the shell.
KONZILO_SITE=@NAME@
KONZILO_CORE=@CORE_PATH@
KONZILO_PORT_SITE=@PORT_SITE@
KONZILO_PORT_ADMIN=@PORT_ADMIN@
KONZILO_PORT_GIT=@PORT_GIT@
KONZILO_PORT_PREVIEW=@PORT_PREVIEW@

# A local copy's people, each with the password in local-secrets/account-password and a
# second factor. Without KONZILO_PEOPLE there is one, the Admin KONZILO_ACCOUNT names, whose
# code `docker compose run --rm code` prints. KONZILO_PEOPLE lists them instead, each
# name:role, the roles admin, editor and reviewer, and a start adds whoever it lists:
# `docker compose run --rm code <name>` prints a person's code.
KONZILO_ACCOUNT=anna
#KONZILO_PEOPLE=anna:admin,ebba:editor,rut:reviewer
