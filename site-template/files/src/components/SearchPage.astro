---
// The search page, which Konzilo's integration puts at the address
// site-description.json declares under `search` (astro.config.mjs names it
// in `searchPage`), on a site in several languages each language's after
// its prefix, which searches that language alone. Konzilo's Search gives
// the form, the results and the messages in the page's language, its title
// and heading too (`search.title` of the texts), and the page says noindex
// through Konzilo's Head in the layout.
// Locally it searches the Typesense KONZILO_TYPESENSE names, if any; online, the
// shared server's.
import Search from '@kntnt/konzilo/astro/Search.astro';
import { pageTexts } from '@kntnt/konzilo/astro/languages';
import Site from '../layouts/Site.astro';

const { title } = pageTexts(Astro.url).search;
---
<Site title={title}>
  <main>
    <h1>{title}</h1>
    <Search />
  </main>
</Site>
