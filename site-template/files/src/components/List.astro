---
// The presentation `list` (site-description.json, astro.config.mjs): a post
// list as the titles of its posts, each linked to its post, with its date
// and what it says of itself where the list asks for its excerpt: its excerpt,
// else its teaser's text, else its standfirst, by Konzilo's ownSummary(). Konzilo
// gives it `posts`, each { entry, url }, the post's entry and its address,
// or null for a type without one; `options`, the presentation's options as
// the list sets them; `empty`, the text for a list that matches nothing; and
// `pager`, for a list with pages of its own, the pager's data, which
// Konzilo's Pager renders after the list (src/styles/pager.css). A date is
// in the page's language, by Konzilo's helper.
import { ownSummary } from '@kntnt/konzilo/astro';
import { longDate } from '@kntnt/konzilo/astro/helpers';
import Pager from '@kntnt/konzilo/astro/Pager.astro';
import '../styles/pager.css';

const { posts, options, empty, pager } = Astro.props;
---
{posts.length === 0 ? <p class="post-list-empty">{empty}</p> : (
  <ul class="post-list">
    {posts.map(({ entry, url }) => (
      <li>
        {url ? <a href={url}>{entry.data.title}</a> : <span>{entry.data.title}</span>}
        {options.date && entry.data.date && <time datetime={entry.data.date.toISOString()}>{longDate(entry.data.date, Astro.url)}</time>}
        {options.excerpt && ownSummary(entry.data) && <p>{ownSummary(entry.data)}</p>}
      </li>
    ))}
  </ul>
)}
{pager && <Pager pager={pager} />}
