{
  "language": "en_GB",
  "search": { "address": "/search/" },
  "types": {
    "article": {
      "collection": "articles",
      "address": "/{slug}/",
      "feed": "/feed/",
      "elements": ["paragraph", "heading", "list", "quote", "code", "table", "footnotes", "embed", "image", "gallery"]
    },
    "page": {
      "collection": "pages",
      "hierarchical": true,
      "address": "/pages/{path}/",
      "elements": ["paragraph", "heading", "list", "code", "table", "embed", "image", "gallery", "post-list", "form"]
    },
    "canvas": {
      "collection": "canvases",
      "address": "/landing/{slug}/",
      "elements": ["paragraph", "heading", "list", "embed", "image", "gallery", "post-list", "form"]
    }
  },
  "taxonomies": {
    "category": { "feed": "/category/{slug}/feed/" },
    "topics": { "feed": "/topic/{slug}/feed/" }
  },
  "presentations": {
    "list": {
      "label": "List",
      "options": {
        "date": { "label": "Date", "type": "boolean", "control": "toggle" },
        "excerpt": { "label": "Excerpt", "type": "boolean", "control": "toggle" }
      }
    },
    "cards": {
      "label": "Cards",
      "options": {
        "columns": { "label": "Columns", "type": "string", "control": "select", "options": ["2", "3", "4"] }
      }
    }
  },
  "images": {
    "smallestWidth": 400,
    "displayWidth": 1280
  },
  "menus": {
    "main": { "label": "Main menu" }
  },
  "settings": {
    "footerText": { "label": "Footer text", "type": "string", "control": "textarea", "translated": true }
  }
}
