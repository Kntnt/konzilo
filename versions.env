# The core's pinned versions: the one source that new-site reads.
#
# Read it with scripts/versions; never source it. One KEY=value per line, the
# value only digits, letters and . + ~ -, comments on lines of their own.

# Local and live. Node's key is no plain NODE, since npm sets that in its scripts'
# environment, and the shell's value goes before a file's in Compose.
NODE_RELEASE=24.22.1
TYPESENSE=30.2

# The images a Compose project runs, each by the digest of its index, so that an
# ARM and an x86 machine run the same pin. The tag only says what the digest is.
NODE_DIGEST=be8204d4bd327363357f532187b752ff62759c31bedf98e9e18fc08c9cbd605c
# Forgejo's digest is that of data.forgejo.org/forgejo/forgejo:${FORGEJO}-rootless,
# the registry Compose pulls from. codeberg.org's serves the same digest, but refuses
# it when under load.
FORGEJO=17.0.1
FORGEJO_DIGEST=5ef02fbcf22beef56b8c844952ffad58cfe177b6f98e46e6abb5df90b88dc8d3
CADDY=2.11.7
CADDY_DIGEST=e70b164da81ef698b3ad19af799ea6086ce6d9e48ed4079eb9fe26f6fbf14ee5
TYPESENSE_DIGEST=610f2d34b1f93d00762869da2c67736775e5798d19a2c8b91b014b8a0cc1e110

# The editor's build, which the web server's image holds. package.json pins the
# same version, and a test holds them together.
SVELTIA=0.256.1
# The body field's editor, in the same image, with the same hold on package.json.
MILKDOWN=7.23.0

# What new-site pins in a new site repository
ASTRO=7.4.2

# The Public Suffix List (publicsuffix.org), at a commit of its repository's
# default branch, which a host a service declares with `*.` is checked against.
# Its rules, the SHA-256 of its file and a copy of the commit are in
# src/format/public-suffixes.json, since the npm package reads no versions.env;
# scripts/public-suffix-list raises both in one go.
PUBLIC_SUFFIX_LIST=73f8cc701c084fe07d888ec552b2f0b53281a674

# SPDX's license list (github.com/spdx/license-list-data), at a release tag, whose
# standard text scripts/notice-texts.js keeps for a package bundled in the
# editor that ships no license text anywhere (ADR 0072).
SPDX_LICENSE_LIST=v3.29.0
