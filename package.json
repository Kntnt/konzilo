{
  "name": "@kntnt/konzilo",
  "version": "0.3.0",
  "description": "Konzilo's content format and Astro integration.",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kntnt/konzilo.git"
  },
  "exports": {
    "./astro": "./src/astro/index.js",
    "./astro/*.astro": "./src/astro/*.astro",
    "./article-parts": "./src/format/article-parts.js",
    "./astro/breadcrumbs": "./src/astro/breadcrumbs.js",
    "./astro/helpers": "./src/astro/helpers.js",
    "./astro/post-lists": "./src/astro/post-lists.js",
    "./astro/site-settings": "./src/astro/site-settings.js",
    "./astro/languages": "./src/astro/site-languages.js",
    "./catalogues/*": "./src/catalogues/*",
    "./consent/*": "./src/consent/*",
    "./post-lists": "./src/post-lists.js",
    "./search": "./src/search.js"
  },
  "bin": {
    "konzilo-search": "./bin/konzilo-search.js",
    "konzilo-intake": "./bin/konzilo-intake.js",
    "konzilo-demo-content": "./bin/konzilo-demo-content.js"
  },
  "files": [
    "bin",
    "src",
    "site-template/demo-content",
    "content-format.md",
    "ACKNOWLEDGEMENTS.md",
    "SITE-EXCEPTION.md",
    "THIRD-PARTY.md",
    "TRADEMARKS.md"
  ],
  "scripts": {
    "test": "node scripts/test.js",
    "gate": "node scripts/gate.js",
    "acceptance": "node --test --test-concurrency=1 --test-timeout=1200000 acceptance/*.test.js"
  },
  "dependencies": {
    "lightningcss": "1.33.0",
    "parse5": "8.0.1",
    "satteri": "0.10.5",
    "sax": "1.6.1",
    "sharp": "0.35.5",
    "svgo": "4.1.0",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@milkdown/crepe": "7.23.0",
    "@milkdown/kit": "7.23.0",
    "@sveltia/cms": "0.256.1",
    "astro": "7.4.2",
    "jsdom": "30.1.1",
    "playwright-core": "1.64.1",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24"
  }
}
