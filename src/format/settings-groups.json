  "tagManager": {
    "when": [
      "types.*.address"
    ],
    "settings": {
      "manager": {
        "type": "string",
        "control": "select",
        "options": [
          "None",
          "Matomo Tag Manager",
          "Matomo"
        ],
        "default": "None"
      },
      "address": {
        "type": "string",
        "control": "text",
        "format": {
          "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+(?:[A-Za-z]{2,63}|xn--[A-Za-z0-9-]{1,59})(?:/[A-Za-z0-9._~%!$&'()*+,;=:@/-]*)?$",
          "refusal": "refusal.format-matomo-address"
        }
      },
      "container": {
        "type": "string",
        "control": "text",
        "format": {
          "pattern": "^[A-Za-z1-9][A-Za-z0-9]{7}$",
          "refusal": "refusal.format-matomo-container"
        }
      },
      "site": {
        "type": "integer",
        "control": "number",
        "min": 1
      },
      "cookieDomain": {
        "type": "string",
        "control": "text",
        "format": {
          "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+(?:[a-z]{2,63}|xn--[a-z0-9-]{1,59})$",
          "refusal": "refusal.format-domain"
        }
      },
      "timeZone": {
        "type": "string",
        "control": "text",
        "format": {
          "pattern": "^(?:UTC|[A-Za-z]+(?:/[A-Za-z0-9_+-]+){1,2})$",
          "refusal": "refusal.format-time-zone"
        }
      }
    },
    "parts": {
      "provider": {
        "settings": {
          "name": {
            "type": "string",
            "control": "text"
          },
          "country": {
            "type": "string",
            "control": "text",
            "format": {
              "pattern": "^[A-Z]{2}$",
              "refusal": "refusal.format-country"
            }
          },
          "privacyPolicy": {
            "type": "string",
            "control": "text",
            "format": {
              "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+(?:[A-Za-z]{2,63}|xn--[A-Za-z0-9-]{1,59})(?:[/?#][^\\s<>\"{}|\\\\^`]*)?$",
              "refusal": "refusal.format-privacy-policy"
            }
          }
        }
      }
    }
  },
  "legalPages": {
    "when": [
      "types.*.address"
    ],
    "settings": {
      "privacyPolicy": {
        "type": "post",
        "control": "post"
      },
      "cookiePolicy": {
        "type": "post",
        "control": "post"
      },
      "accessibilityStatement": {
        "type": "post",
        "control": "post"
      }
    }
  },
  "forms": {
    "each": "forms",
    "settings": {
      "recipients": {
        "type": "string",
        "control": "text",
        "published": false
      },
      "confirmation": {
        "type": "string",
        "control": "textarea",
        "translated": true,
        "default": { "text": "site.settings.forms.confirmation" }
      },
      "retention": {
        "type": "integer",
        "control": "number",
        "default": 30,
        "published": false
      }
    }
  },
  "notFound": {
    "when": [
      "types.*.address"
    ],
    "settings": {
      "page": {
        "type": "post",
        "control": "post"
      }
    }
  },
  "feeds": {
    "when": [
      "types.*.feed",
      "taxonomies.*.feed"
    ],
    "settings": {
      "item": {
        "type": "string",
        "control": "select",
        "options": [
          "The summary",
          "The whole text"
        ],
        "default": "The summary"
      },
      "posts": {
        "type": "integer",
        "control": "number",
        "min": 1,
        "default": 10
      }
    }
  },
  "related": {
    "when": [
      "types.article",
      "taxonomies.*"
    ],
    "settings": {
      "freshness": {
        "type": "boolean",
        "control": "toggle",
        "default": true
      },
      "halfLife": {
        "type": "integer",
        "control": "number",
        "min": 1,
        "default": 90
      }
    }
  }
}
