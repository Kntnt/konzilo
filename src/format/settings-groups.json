{
  "search": {
    "settings": {
      "separator": {
        "type": "string",
        "control": "text",
        "default": "–"
      },
      "description": {
        "type": "string",
        "control": "textarea",
        "translated": true
      },
      "image": {
        "type": "image",
        "control": "image"
      }
    },
    "parts": {
      "publisher": {
        "settings": {
          "kind": {
            "type": "string",
            "control": "select",
            "options": [
              "Organization",
              "Person"
            ],
            "default": "Organization"
          },
          "name": {
            "type": "string",
            "control": "text",
            "default": {
              "identity": "title"
            }
          },
          "organisationNumber": {
            "type": "string",
            "control": "text"
          },
          "vatNumber": {
            "type": "string",
            "control": "text"
          },
          "tradeRegister": {
            "type": "string",
            "control": "text"
          },
          "supervisoryAuthority": {
            "type": "string",
            "control": "textarea"
          },
          "street": {
            "type": "string",
            "control": "text"
          },
          "postalCode": {
            "type": "string",
            "control": "text"
          },
          "locality": {
            "type": "string",
            "control": "text"
          },
          "country": {
            "type": "string",
            "control": "text"
          },
          "email": {
            "type": "string",
            "control": "text"
          },
          "telephone": {
            "type": "string",
            "control": "text"
          },
          "profiles": {
            "type": "string",
            "control": "textarea"
          }
        }
      },
      "home": {
        "settings": {
          "title": {
            "type": "string",
            "control": "text",
            "template": true,
            "default": "{{ site.title }}",
            "translated": true
          },
          "description": {
            "type": "string",
            "control": "textarea",
            "template": true,
            "default": "{{ site.description }}",
            "translated": true
          },
          "socialTitle": {
            "type": "string",
            "control": "text",
            "template": true,
            "default": "{{ site.title }}",
            "translated": true
          },
          "socialDescription": {
            "type": "string",
            "control": "textarea",
            "template": true,
            "default": "{{ site.description }}",
            "translated": true
          }
        }
      }
    },
    "types": {
      "only": "address",
      "settings": {
        "title": {
          "type": "string",
          "control": "text",
          "template": true,
          "default": "{{ post.title }} {{ sep }} {{ site.title }}",
          "translated": true
        },
        "description": {
          "type": "string",
          "control": "textarea",
          "template": true,
          "default": "{{ post.auto_description }}",
          "translated": true
        },
        "socialTitle": {
          "type": "string",
          "control": "text",
          "template": true,
          "default": "{{ post.title }}",
          "translated": true
        },
        "socialDescription": {
          "type": "string",
          "control": "textarea",
          "template": true,
          "default": "{{ post.auto_description }}",
          "translated": true
        },
        "schema": {
          "type": "string",
          "control": "select",
          "options": [
            "Article",
            "BlogPosting",
            "NewsArticle",
            "WebPage",
            "AboutPage",
            "ContactPage",
            "CollectionPage"
          ],
          "default": "WebPage",
          "defaultFor": {
            "date": "Article"
          }
        }
      }
    }
  },
  "breadcrumbs": {
    "types": {
      "only": "address",
      "settings": {
        "current": {
          "type": "boolean",
          "control": "toggle",
          "default": false
        }
      }
    }
  },
  "ai": {
    "table": [
      "home"
    ],
    "settings": {
      "excludedPaths": {
        "type": "string",
        "control": "textarea",
        "patterns": true
      }
    },
    "parts": {
      "home": {
        "settings": {
          "markdown": {
            "type": "boolean",
            "control": "toggle",
            "default": true
          },
          "llms": {
            "type": "boolean",
            "control": "toggle",
            "default": true,
            "requires": "markdown"
          },
          "llmsFull": {
            "type": "boolean",
            "control": "toggle",
            "default": true,
            "requires": "markdown"
          }
        }
      },
      "signals": {
        "settings": {
          "search": {
            "type": "string",
            "control": "select",
            "options": [
              "grant",
              "reserve",
              "defer"
            ],
            "default": "defer"
          },
          "aiInput": {
            "type": "string",
            "control": "select",
            "options": [
              "grant",
              "reserve",
              "defer"
            ],
            "default": "grant"
          },
          "aiTrain": {
            "type": "string",
            "control": "select",
            "options": [
              "grant",
              "reserve",
              "defer"
            ],
            "default": "defer"
          }
        }
      }
    },
    "types": {
      "only": "address",
      "settings": {
        "markdown": {
          "type": "boolean",
          "control": "toggle",
          "default": true
        },
        "llms": {
          "type": "boolean",
          "control": "toggle",
          "default": true,
          "requires": "markdown"
        },
        "llmsFull": {
          "type": "boolean",
          "control": "toggle",
          "default": false,
          "defaultFor": {
            "page": true
          },
          "requires": "markdown"
        }
      }
    }
  },
  "consent": {
    "settings": {
      "bannerTitle": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Your privacy",
          "sv": "Din integritet"
        }
      },
      "bannerText": {
        "type": "string",
        "control": "textarea",
        "translated": true,
        "default": {
          "en": "This site uses only what it needs to work, unless you allow more. With your consent it also loads content from other services, such as videos, which may store data in your browser and use what they learn for their own purposes. You can change or withdraw your consent at any time, from the bottom of every page.",
          "sv": "Webbplatsen använder bara det den behöver för att fungera, om du inte tillåter mer. Med ditt samtycke laddar den också innehåll från andra tjänster, till exempel videor, som kan lagra uppgifter i din webbläsare och använda det de får veta för egna syften. Du kan ändra eller återkalla ditt samtycke när som helst, längst ned på varje sida."
        }
      },
      "bannerAccept": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Accept all",
          "sv": "Acceptera alla"
        }
      },
      "bannerReject": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Reject optional",
          "sv": "Neka valfria"
        }
      },
      "bannerCustomise": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Customise",
          "sv": "Anpassa"
        }
      },
      "dialogTitle": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Privacy settings",
          "sv": "Integritetsinställningar"
        }
      },
      "dialogIntroduction": {
        "type": "string",
        "control": "textarea",
        "translated": true,
        "default": {
          "en": "Choose what the site may load and store beyond what it needs to work. Each category lists its services, who provides them, what they store and for how long. Your choice holds for 12 months. You can change or withdraw it at any time from the footer of every page.",
          "sv": "Välj vad webbplatsen får ladda och lagra utöver det den behöver för att fungera. Varje kategori visar sina tjänster, vem som tillhandahåller dem, vad de lagrar och hur länge. Ditt val gäller i 12 månader. Du kan när som helst ändra eller återkalla det i sidfoten på varje sida."
        }
      },
      "dialogAccept": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Accept all",
          "sv": "Acceptera alla"
        }
      },
      "dialogReject": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Reject optional",
          "sv": "Neka valfria"
        }
      },
      "dialogSave": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Save my choices",
          "sv": "Spara mina val"
        }
      },
      "dialogClose": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Close",
          "sv": "Stäng"
        }
      },
      "footerChange": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Change privacy settings",
          "sv": "Ändra integritetsinställningar"
        }
      },
      "footerWithdraw": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Withdraw consent",
          "sv": "Återkalla samtycke"
        }
      },
      "noticeWithdrawn": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Your consents have been withdrawn. The page will reload.",
          "sv": "Dina samtycken har återkallats. Sidan laddas om."
        }
      },
      "placeholderQuestion": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Allow {service} to play this content?",
          "sv": "Vill du låta {service} spela upp det här innehållet?"
        }
      },
      "placeholderButton": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Allow and play",
          "sv": "Tillåt och spela upp"
        }
      },
      "objectionText": {
        "type": "string",
        "control": "textarea",
        "translated": true,
        "default": {
          "en": "We can't see who you are, we don't follow you from one visit to the next, and we don't profile you. All we do is count the visits: how many there are, which pages are read and for how long, from which country, in which language and with which browser, and when in the day. We do so on our legitimate interest in knowing this. If you disagree, you have the right to [object].",
          "sv": "Vi kan inte se vem du är, vi följer dig inte mellan besök och vi gör ingen profilering. Det enda vi gör är att räkna besöken: hur många de är, vilka sidor som läses och hur länge, från vilket land, med vilket språk och vilken webbläsare, och när på dygnet. Det gör vi med stöd av vårt berättigade intresse av att veta det. Håller du inte med har du rätt att [invända]."
        }
      },
      "objectionObjected": {
        "type": "string",
        "control": "textarea",
        "translated": true,
        "default": {
          "en": "You have objected to the counting, so your visits are not counted. [Undo your objection]",
          "sv": "Du har invänt mot räkningen, så dina besök räknas inte. [Ångra din invändning]"
        }
      },
      "objectionTitle": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Don't count my visits",
          "sv": "Räkna inte mina besök"
        }
      },
      "objectionAppeal": {
        "type": "string",
        "control": "textarea",
        "translated": true,
        "default": {
          "en": "Do you really want us to stop counting your visits? We can't see who you are, and we don't follow you from one visit to the next. The figures help us understand what is valuable on the site and what we need to do better.",
          "sv": "Vill du verkligen att vi slutar räkna dina besök? Vi ser inte vem du är och följer dig inte mellan besök. Siffrorna hjälper oss att förstå vad som är värdefullt på webbplatsen och vad vi behöver göra bättre."
        }
      },
      "objectionConfirm": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Don't count my visits",
          "sv": "Räkna inte mina besök"
        }
      },
      "objectionCancel": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Cancel",
          "sv": "Avbryt"
        }
      },
      "necessaryName": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Necessary",
          "sv": "Nödvändiga"
        }
      },
      "necessaryDescription": {
        "type": "string",
        "control": "textarea",
        "translated": true,
        "default": {
          "en": "What the site needs to work and to remember your choice. Always on.",
          "sv": "Det webbplatsen behöver för att fungera och för att komma ihåg ditt val. Alltid på."
        }
      },
      "functionalName": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Functional",
          "sv": "Funktionella"
        }
      },
      "functionalDescription": {
        "type": "string",
        "control": "textarea",
        "translated": true,
        "default": {
          "en": "Content and features from other services, such as videos and charts, whose providers do not use what they learn for their own advertising or profiling.",
          "sv": "Innehåll och funktioner från andra tjänster, till exempel videor och diagram, vars leverantörer inte använder det de får veta för egen annonsering eller profilering."
        }
      },
      "statisticsName": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Statistics",
          "sv": "Statistik"
        }
      },
      "statisticsDescription": {
        "type": "string",
        "control": "textarea",
        "translated": true,
        "default": {
          "en": "Measuring how visitors use the site, so that it can be made better.",
          "sv": "Mätning av hur besökare använder webbplatsen, så att den kan bli bättre."
        }
      },
      "statisticsWithoutStorageDescription": {
        "type": "string",
        "control": "textarea",
        "translated": true,
        "default": {
          "en": "Measuring how visitors use the site, so that it can be made better. Each visit is counted from the first page, without storing anything in your browser or reading your device's properties. With your consent, the statistics also store an ID in your browser, so that a visitor who comes back is counted once.",
          "sv": "Mätning av hur besökare använder webbplatsen, så att den kan bli bättre. Varje besök räknas från första sidan, utan att något lagras i din webbläsare och utan att din enhets egenskaper läses av. Med ditt samtycke lagrar statistiken också ett ID i din webbläsare, så att en besökare som kommer tillbaka räknas en gång."
        }
      },
      "marketingName": {
        "type": "string",
        "control": "text",
        "translated": true,
        "default": {
          "en": "Marketing",
          "sv": "Marknadsföring"
        }
      },
      "marketingDescription": {
        "type": "string",
        "control": "textarea",
        "translated": true,
        "default": {
          "en": "Content and features from services whose providers may use what they learn about you for their own advertising or profiling.",
          "sv": "Innehåll och funktioner från tjänster vars leverantörer kan använda det de får veta om dig för egen annonsering eller profilering."
        }
      }
    }
  },
  "tagManager": {
    "when": [
      "types.*.address"
    ],
    "settings": {
      "manager": {
        "type": "string",
        "control": "select",
        "options": [
          "None",
          "Matomo Tag Manager",
          "Matomo"
        ],
        "default": "None"
      },
      "address": {
        "type": "string",
        "control": "text",
        "format": {
          "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+(?:[A-Za-z]{2,63}|xn--[A-Za-z0-9-]{1,59})(?:/[A-Za-z0-9._~%!$&'()*+,;=:@/-]*)?$",
          "reason": "must be the https:// address of the Matomo instance, its host with a path or none, such as https://matomo.example.com/, with no port, query or fragment"
        }
      },
      "container": {
        "type": "string",
        "control": "text",
        "format": {
          "pattern": "^[A-Za-z1-9][A-Za-z0-9]{7}$",
          "reason": "must be the container's ID as Matomo gives it, eight letters and digits, such as aBcD1234"
        }
      },
      "site": {
        "type": "integer",
        "control": "number",
        "min": 1
      },
      "cookieDomain": {
        "type": "string",
        "control": "text",
        "format": {
          "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+(?:[a-z]{2,63}|xn--[a-z0-9-]{1,59})$",
          "reason": "must be a domain name in lowercase, such as example.com"
        }
      },
      "timeZone": {
        "type": "string",
        "control": "text",
        "format": {
          "pattern": "^(?:UTC|[A-Za-z]+(?:/[A-Za-z0-9_+-]+){1,2})$",
          "reason": "must be a time zone by its IANA name, such as Europe/Paris, or UTC"
        }
      }
    },
    "parts": {
      "provider": {
        "settings": {
          "name": {
            "type": "string",
            "control": "text"
          },
          "country": {
            "type": "string",
            "control": "text",
            "format": {
              "pattern": "^[A-Z]{2}$",
              "reason": "must be the country's two-letter code in capitals, such as SE"
            }
          },
          "privacyPolicy": {
            "type": "string",
            "control": "text",
            "format": {
              "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+(?:[A-Za-z]{2,63}|xn--[A-Za-z0-9-]{1,59})(?:[/?#][^\\s<>\"{}|\\\\^`]*)?$",
              "reason": "must be the https:// address of its privacy policy, such as https://www.example.com/privacy/"
            }
          }
        }
      }
    }
  },
  "legalPages": {
    "when": [
      "types.*.address"
    ],
    "settings": {
      "privacyPolicy": {
        "type": "post",
        "control": "post"
      },
      "cookiePolicy": {
        "type": "post",
        "control": "post"
      },
      "accessibilityStatement": {
        "type": "post",
        "control": "post"
      }
    }
  },
  "forms": {
    "each": "forms",
    "settings": {
      "recipients": {
        "type": "string",
        "control": "text",
        "published": false
      },
      "confirmation": {
        "type": "string",
        "control": "textarea",
        "translated": true,
        "default": {
          "en": "Thank you. Your message has been sent.",
          "sv": "Tack! Ditt meddelande är skickat."
        }
      },
      "retention": {
        "type": "integer",
        "control": "number",
        "default": 30,
        "published": false
      }
    }
  },
  "notFound": {
    "when": [
      "types.*.address"
    ],
    "settings": {
      "page": {
        "type": "post",
        "control": "post"
      }
    }
  },
  "feeds": {
    "when": [
      "types.*.feed",
      "taxonomies.*.feed"
    ],
    "settings": {
      "item": {
        "type": "string",
        "control": "select",
        "options": [
          "The summary",
          "The whole text"
        ],
        "default": "The summary"
      },
      "posts": {
        "type": "integer",
        "control": "number",
        "min": 1,
        "default": 10
      }
    }
  }
}
