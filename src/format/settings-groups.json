{
  "search": {
    "settings": {
      "separator": {
        "type": "string",
        "control": "text",
        "default": "–"
      },
      "description": {
        "type": "string",
        "control": "textarea",
        "translated": true
      },
      "image": {
        "type": "image",
        "control": "image"
      }
    },
    "parts": {
      "publisher": {
        "settings": {
          "kind": {
            "type": "string",
            "control": "select",
            "options": [
              "Organization",
              "Person"
            ],
            "default": "Organization"
          },
          "name": {
            "type": "string",
            "control": "text",
            "default": {
              "identity": "title"
            }
          },
          "organisationNumber": {
            "type": "string",
            "control": "text"
          },
          "vatNumber": {
            "type": "string",
            "control": "text"
          },
          "tradeRegister": {
            "type": "string",
            "control": "text"
          },
          "supervisoryAuthority": {
            "type": "string",
            "control": "textarea"
          },
          "street": {
            "type": "string",
            "control": "text"
          },
          "postalCode": {
            "type": "string",
            "control": "text"
          },
          "locality": {
            "type": "string",
            "control": "text"
          },
          "country": {
            "type": "string",
            "control": "text"
          },
          "email": {
            "type": "string",
            "control": "text"
          },
          "telephone": {
            "type": "string",
            "control": "text"
          },
          "profiles": {
            "type": "string",
            "control": "textarea"
          }
        }
      },
      "home": {
        "settings": {
          "title": {
            "type": "string",
            "control": "text",
            "template": true,
            "default": "{{ site.title }}",
            "translated": true
          },
          "description": {
            "type": "string",
            "control": "textarea",
            "template": true,
            "default": "{{ site.description }}",
            "translated": true
          },
          "socialTitle": {
            "type": "string",
            "control": "text",
            "template": true,
            "default": "{{ site.title }}",
            "translated": true
          },
          "socialDescription": {
            "type": "string",
            "control": "textarea",
            "template": true,
            "default": "{{ site.description }}",
            "translated": true
          }
        }
      }
    },
    "types": {
      "only": "address",
      "settings": {
        "title": {
          "type": "string",
          "control": "text",
          "template": true,
          "default": "{{ post.title }} {{ sep }} {{ site.title }}",
          "translated": true
        },
        "description": {
          "type": "string",
          "control": "textarea",
          "template": true,
          "default": "{{ post.auto_description }}",
          "translated": true
        },
        "socialTitle": {
          "type": "string",
          "control": "text",
          "template": true,
          "default": "{{ post.title }}",
          "translated": true
        },
        "socialDescription": {
          "type": "string",
          "control": "textarea",
          "template": true,
          "default": "{{ post.auto_description }}",
          "translated": true
        },
        "schema": {
          "type": "string",
          "control": "select",
          "options": [
            "Article",
            "BlogPosting",
            "NewsArticle",
            "WebPage",
            "AboutPage",
            "ContactPage",
            "CollectionPage"
          ],
          "default": "WebPage",
          "defaultFor": {
            "article": "Article"
          }
        }
      }
    }
  },
  "metaLine": {
    "types": {
      "only": "address",
      "settings": {
        "format": {
          "type": "string",
          "control": "text",
          "metaLine": true,
          "translated": true,
          "defaultFor": {
            "article": { "text": "site.settings.metaLine.article" }
          }
        }
      }
    }
  },
  "breadcrumbs": {
    "types": {
      "only": "address",
      "settings": {
        "current": {
          "type": "boolean",
          "control": "toggle",
          "default": false
        }
      }
    }
  },
  "ai": {
    "table": [
      "home"
    ],
    "settings": {
      "excludedPaths": {
        "type": "string",
        "control": "textarea",
        "patterns": true
      }
    },
    "parts": {
      "home": {
        "settings": {
          "markdown": {
            "type": "boolean",
            "control": "toggle",
            "default": true
          },
          "llms": {
            "type": "boolean",
            "control": "toggle",
            "default": true,
            "requires": "markdown"
          },
          "llmsFull": {
            "type": "boolean",
            "control": "toggle",
            "default": true,
            "requires": "markdown"
          }
        }
      },
      "signals": {
        "settings": {
          "search": {
            "type": "string",
            "control": "select",
            "options": [
              "grant",
              "reserve",
              "defer"
            ],
            "default": "defer"
          },
          "aiInput": {
            "type": "string",
            "control": "select",
            "options": [
              "grant",
              "reserve",
              "defer"
            ],
            "default": "grant"
          },
          "aiTrain": {
            "type": "string",
            "control": "select",
            "options": [
              "grant",
              "reserve",
              "defer"
            ],
            "default": "defer"
          }
        }
      }
    },
    "types": {
      "only": "address",
      "settings": {
        "markdown": {
          "type": "boolean",
          "control": "toggle",
          "default": true
        },
        "llms": {
          "type": "boolean",
          "control": "toggle",
          "default": true,
          "requires": "markdown"
        },
        "llmsFull": {
          "type": "boolean",
          "control": "toggle",
          "default": false,
          "defaultFor": {
            "page": true
          },
          "requires": "markdown"
        }
      }
    }
  },
