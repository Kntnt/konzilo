---
// A post's body, with each directive the site gives a component of its own
// (`konzilo({ directives })`) rendered by that component in place of its
// plain rendering, and each post list evaluated and
// rendered by the presentation the site registers for it (`konzilo({
// presentations })`). A site's template renders a post's body as
//
//   <Body post={entry}><Content /></Body>
//
// with Content from Astro's render(entry), and `post` the post's entry,
// which a list leaves out and ranks related posts by. Each component is
// given the directive's attributes as its props, typed, those not given at
// their defaults, and its body, if it has one, as its default slot,
// rendered here again, so that a directive in a container's body gets its
// component too, and as a hast tree in the prop `content`, for a component
// that lays itself out by what it holds (bodyTree() in directives.js), with
// the live preview's marks on its blocks. The lists are evaluated in the
// body's order, before any is rendered, so that each leaves out the posts
// the lists above it showed. A
// body without such a directive comes out as Content renders it, but for each image's lightbox
// (lightbox.js), which is the page's and no part of the body's own HTML.
//
// `page`: the page of the post shown, from 1, as the site's route has it
// from postPages() (post-lists.js): the one list with pages of its own shows
// that page's slice, and its presentation is given the pager; every other
// list shows its first slice.
//
//   <Body post={entry} page={page}><Content /></Body>
import components from 'virtual:konzilo/directives';
import './modal.css';
import BlockMark from './BlockMark.astro';
import { BLOCK_ATTRIBUTE } from './block-marks.js';
import { bodyParts } from './directives.js';
import { withLightboxes } from './lightbox.js';
import { postList, shownOnPage } from './post-lists.js';
import { publicSite } from './public-site.js';

const LIST = 'post-list';
const { html = await Astro.slots.render('default'), post, shown = shownOnPage(), page = 1 } = Astro.props;
const parts = bodyParts(html, [...Object.keys(components), LIST]);
for (const part of parts) {
  if (typeof part !== 'string' && part.name === LIST) part.list = await postList(part.attributes, { post, shown, page });
}
// A number for each dialog on the page, however many bodies it renders.
const lightboxes = {
  locale: publicSite(Astro.url).locale,
  next: () => {
    Astro.locals.konziloDialogs = (Astro.locals.konziloDialogs ?? 0) + 1;
    return Astro.locals.konziloDialogs;
  },
};
---
{parts.map((part) => {
  if (typeof part === 'string') return <Fragment set:html={withLightboxes(part, lightboxes)} />;
  // In the live preview a component is given the mark of its block to place on its root, and
  // keeps it there whether it does or not (BlockMark.astro, block-marks.js).
  const mark = part.block === null ? {} : { [BLOCK_ATTRIBUTE]: part.block };
  const marked = (rendered) => (part.block === null ? rendered : <BlockMark block={part.block}>{rendered}</BlockMark>);
  if (part.list) {
    const { component: Presentation, posts, options, empty, pager } = part.list;
    return marked(<Presentation posts={posts} options={options} empty={empty} pager={pager} {...mark} />);
  }
  const Component = components[part.name];
  return marked(part.body === null ? <Component {...part.attributes} {...mark} /> : <Component {...part.attributes} {...mark} content={part.content}><Astro.self html={part.body} post={post} shown={shown} page={page} /></Component>);
})}
