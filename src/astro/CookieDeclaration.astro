---
// The cookie declaration, rendered from the service registry,
// content/consent.json, in the page's language, by the consent's markup
// function (src/consent/markup.js, cookieDeclarationMarkup()), on the page
// the site settings choose as the cookie policy, and on no other. A site's
// templates place it after a page's body, in every template of a type with
// an address, since the cookie policy may be a post of any of them:
//
//   import CookieDeclaration from '@kntnt/konzilo/astro/CookieDeclaration.astro';
//   <Body post={page}><Content /></Body>
//   <CookieDeclaration />
//
// `level` is the level of its top headings, 2 by default, below the page's
// title; each category's heading is one level below, each service's two.
//
// It shows the visitor's own consent first: with the integration's script
// the consent ID, on the public site alone, which sends the records it
// names, when the choice was made and what it allows, beside Change privacy
// settings and Withdraw consent, which the consent client shows and acts
// on; without it, a sentence that this part needs the script. Then each
// category of the registry, in its order, with its name, its description
// and its services, each with its provider, purpose, why it is necessary
// where it is, the hosts it reaches, its transfers outside the EU and EEA
// and a table of what it stores, after the day the registry last changed;
// and each departure with its reason. The elements carry classes of their
// own, `konzilo-declaration-*`, which the site styles, keeping an element
// with `hidden` hidden; the component has no style of its own, as
// ConsentBanner.astro says.
import { getEntry } from 'astro:content';
import { cookieDeclarationMarkup } from '../consent/markup.js';
import { CONSENT_RECORDS, consentInput, isCookiePolicy } from './consent.js';
import { isPublicBuild, publicSite } from './public-site.js';
import { siteSettings } from './site-settings.js';

const { level = 2 } = Astro.props;
const registry = (await getEntry('consent', 'registry'))?.data;
const settings = await siteSettings(Astro.url);
const { languageTag } = publicSite(Astro.url);
const base = import.meta.env.BASE_URL;
const html = registry && isCookiePolicy(Astro.url.pathname, settings, base)
  ? cookieDeclarationMarkup(consentInput(registry, settings, { languageTag, base }), { level, records: isPublicBuild(base) ? CONSENT_RECORDS : null })
  : '';
---
<Fragment set:html={html} />
