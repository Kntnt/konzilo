---
// The footer controls of the consent, on every page, rendered by the
// consent's markup function (src/consent/markup.js,
// consentControlsMarkup()): links to the privacy policy and the cookie
// policy the site settings choose, those of the page's language on a site
// in several, and two buttons, since neither navigates: Change privacy
// settings, which opens the dialog of ConsentBanner.astro, and Withdraw
// consent, which at once rejects every optional category and service and
// reloads the page. A site's layout places it in the footer:
//
//   import ConsentControls from '@kntnt/konzilo/astro/ConsentControls.astro';
//   <footer>... <ConsentControls /></footer>
//
// `links={false}` leaves the links out, for a footer that links the legal
// pages itself, and `buttons={false}` the buttons, so that each can stand in a
// place of its own. The buttons show only with JavaScript, and only where the
// registry asks for consent. `objection` adds the right to object to
// counting without storage, as the dialog has it, where the site counts
// so, for a template such as the privacy policy's to place:
//
//   <ConsentControls links={false} buttons={false} objection />
//
// It too shows only with JavaScript, and only while the visitor does not
// allow statistics. The elements carry classes of their
// own, `konzilo-consent-*`, which the site styles, as ConsentBanner.astro
// says.
import { getEntry } from 'astro:content';
import { consentControlsMarkup } from '../consent/markup.js';
import { consentInput } from './consent.js';
import { publicSite } from './public-site.js';
import { siteSettings } from './site-settings.js';

const { links = true, buttons = true, objection = false } = Astro.props;
const registry = (await getEntry('consent', 'registry'))?.data;
const settings = await siteSettings(Astro.url);
const { languageTag, origin } = publicSite(Astro.url);
const html = registry ? consentControlsMarkup(consentInput(registry, settings, { languageTag, base: import.meta.env.BASE_URL, origin }), { links, buttons, objection }) : '';
---
<Fragment set:html={html} />
