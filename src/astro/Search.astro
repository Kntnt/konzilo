---
// The search page's search: what the site's search page, a page
// of the site's design that the integration places at the site
// description's address (konzilo({ searchPage })), shows in its main part:
//
//   import Search from '@kntnt/konzilo/astro/Search.astro';
//   <Search />                        or <Search texts={{ nothingFound: '…' }} />
//
// A form that asks again with the query in `q`, and with the type and the
// terms the search was narrowed by (search-client.js), a status that screen
// readers announce, the list of results and the links to the other pages of
// them, which the page's script fills (search-client.js), and a message in
// <noscript> for a browser that runs no script. On a site in several
// languages it searches the page's language alone, with that
// language's analysis, and asks again at its own address. Its texts are the
// site's language's, the page's on a site in several, the site's own
// (site-texts.js) or the core's (SEARCH_TEXTS in search.js), and `texts`
// gives any of the template's own over them. In a preview or a share's preview, which are built
// below a base of their own, it says that search is not
// in the preview, and its script asks nothing. A site without search shows
// nothing of it.
import { getCollection } from 'astro:content';
import { textsIn } from 'virtual:konzilo/texts';
import { isPublicBuild, publicSite } from './public-site.js';
import { SEARCH_ROUTE, searchPage, searchTerms, searchTexts } from './search.js';
// The script as a file of its own, which the build copies as it is: an
// Astro <script> in a package that a site links to by path, as a site pinned
// by path and the converter suite's sites do, fails the build
// (seen with Astro 7.4.2: "No cached compile metadata found"). Never inlined,
// so that the page holds no code of its own.
import client from './search-client.js?url&no-inline';

const { texts: given = {} } = Astro.props;
const page = searchPage(Astro.url);
const { locale, languageTag } = publicSite(Astro.url);
const texts = page && searchTexts(locale, { ...textsIn(locale).search, ...given });
const preview = !isPublicBuild(import.meta.env.BASE_URL);
const action = page && `${import.meta.env.BASE_URL}${page.address.slice(1)}`;
const terms = page && !preview ? await searchTerms(page, { getCollection }) : {};
---
{page && preview && <p class="konzilo-search-preview">{texts.notInPreview}</p>}
{page && !preview && (
  <div class="konzilo-search" data-konzilo-search={SEARCH_ROUTE} data-language-tag={languageTag} data-language={page.language ?? undefined} data-taxonomies={JSON.stringify(terms)} data-texts={JSON.stringify(texts)}>
    <form role="search" method="get" action={action}>
      <label for="konzilo-search-query">{texts.label}</label>
      <input id="konzilo-search-query" type="search" name="q" />
      <button type="submit">{texts.submit}</button>
    </form>
    <noscript><p class="konzilo-search-message">{texts.needsJavaScript}</p></noscript>
    <p class="konzilo-search-status" role="status"></p>
    <ol class="konzilo-search-results"></ol>
    <nav class="konzilo-search-pages" aria-label={texts.pages} hidden></nav>
  </div>
)}
{page && !preview && <script is:inline type="module" src={client}></script>}
