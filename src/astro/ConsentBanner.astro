---
// The consent banner and the preferences dialog, rendered from the service
// registry, content/consent.json, in the page's language, by the consent's
// markup function (src/consent/markup.js, consentMarkup()). A site's layout
// places it once on every page, first in the body:
//
//   import ConsentBanner from '@kntnt/konzilo/astro/ConsentBanner.astro';
//   <body><ConsentBanner /> ...</body>
//
// The banner is a compact box that blocks nothing, with Accept all and
// Reject optional alike and Customise secondary; the dialog a native modal
// <dialog> with a row per category, its services and what each stores.
// Both start hidden, and the integration's script (src/consent/client.js)
// shows the banner while no choice holds, so a visitor without JavaScript
// sees neither. On the privacy policy and the cookie policy the site
// settings choose, the banner stays hidden; the footer controls work there. A registry that asks no consent shows no banner and no
// dialog; the page still holds the registry for the consent signal. It also
// holds, in a <template> each, the placeholder of every embed service that
// waits for consent, which the integration's script puts in each panel of
// the service until the visitor allows it. The elements carry classes of
// their own, `konzilo-consent-*`, which the site styles (docs/site-design.md);
// its styles keep an element with `hidden` hidden and leave the banner out
// of print. The component has no style of its own: Astro cannot compile one
// in a package outside the site's root, as a site that pins a checkout of
// the core has it.
import { getEntry } from 'astro:content';
import { consentMarkup } from '../consent/markup.js';
import { consentInput, isLegalPage } from './consent.js';
import { publicSite } from './public-site.js';
import { siteSettings } from './site-settings.js';

const registry = (await getEntry('consent', 'registry'))?.data;
const settings = await siteSettings(Astro.url);
const { languageTag, origin } = publicSite(Astro.url);
const base = import.meta.env.BASE_URL;
const html = registry ? consentMarkup(consentInput(registry, settings, { languageTag, base, origin }), { legalPage: isLegalPage(Astro.url.pathname, settings, base) }) : '';
---
<Fragment set:html={html} />
