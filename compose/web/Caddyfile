# One port per host, each its own origin, as ADR 0002 has it locally.

{
	admin off
	auto_https off
	persist_config off
	skip_install_trust
}

# The public site: static pages, and nothing that holds a draft. `current` moves to a new
# release all at once (ADR 0031), and the release's headers and redirects are read from what
# the build wrote beside its pages, which this server looks for by itself: it runs with
# `--watch`, and reloads only when they have changed. There are none before the first build.
:{$KONZILO_PORT_SITE} {
	root * /srv/site/current/pages
	import /srv/site/current/web-rules*.caddy
	# Search (ADR 0053): the route to Typesense, with its key, which every build writes outside
	# the releases, where no visitor reaches it; none before the first build.
	import /srv/search/search-route*.caddy
	# The service, in its role for visitors (ADR 0044): every other path below the reserved prefix,
	# but the consent scripts' files, which are the release's to serve, GET alone (ADR 0049). It is
	# passed the request's method, path, query and body with its type, where the browser says it
	# came from, the visitor's address and the host it came to, and nothing else: no cookie,
	# browser, password or language. A body is cut off at a megabyte, and nothing is logged.
	@konzilo_visitors {
		path /_konzilo/*
		not path /_konzilo/search /_konzilo/search/*
		not {
			path /_konzilo/consent/*
			method GET HEAD
		}
	}
	handle @konzilo_visitors {
		request_body {
			max_size 1MB
		}
		reverse_proxy visitors:4200 {
			header_up -*
			header_up Content-Type {http.request.header.Content-Type}
			header_up Origin {http.request.header.Origin}
			header_up Referer {http.request.header.Referer}
			header_up Sec-Fetch-Site {http.request.header.Sec-Fetch-Site}
			header_up X-Konzilo-Client {http.request.remote.host}
			header_up X-Konzilo-Host {http.request.hostport}
			transport http {
				dial_timeout 5s
				response_header_timeout 10s
			}
		}
	}
	file_server
	handle_errors {
		# Search that Typesense does not answer says so, as the dev server's does.
		@search_down {
			path /_konzilo/search
			expression `{err.status_code} >= 500`
		}
		handle @search_down {
			header Content-Type `application/json; charset=utf-8`
			header Cache-Control no-store
			respond `{"message":"Search does not answer."}` 502
		}
		# A form the service does not answer gets the release's page that says it was not sent,
		# with the status the web server gives (ADR 0045): a page of its own, which a browser
		# without JavaScript shows, and the page's script reads as no answer of the service's.
		@form_down {
			path /_konzilo/forms/*
			expression `{err.status_code} >= 500`
		}
		handle @form_down {
			method GET
			rewrite * /_konzilo/form-not-sent.html
			header Cache-Control no-store
			file_server
		}
		handle {
			rewrite * /404.html
			file_server
		}
	}
}

# The editor (ADR 0029): static files, with a policy of its own and no cross-origin
# opener policy, since its sign-in uses a popup. It holds a write token in the
# browser, so it never shows anything an editor wrote as HTML: the page in its preview
# pane comes from the preview's origin (ADR 0032).
:{$KONZILO_PORT_ADMIN} {
	encode zstd gzip
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$KONZILO_FORGEJO_ORIGIN}; media-src 'self' blob: {$KONZILO_FORGEJO_ORIGIN}; font-src 'self' data:; connect-src 'self' blob: data: {$KONZILO_FORGEJO_ORIGIN} {$KONZILO_PREVIEW_ORIGIN}; frame-src {$KONZILO_PREVIEW_ORIGIN}; worker-src 'self' blob:; manifest-src 'self' blob:; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}
	# The generated configuration, in the site's interface language and in each other
	# (ADR 0066).
	@config path /config.json /config.*.json
	handle @config {
		root * /srv/admin-config
		header Cache-Control "no-store"
		file_server
	}
	# How publishing stands (ADR 0031), and small pictures of images (ADR 0055), from the service,
	# which asks Forgejo who is asking.
	@service path /_konzilo/status /_konzilo/thumbnail
	handle @service {
		reverse_proxy editors:4100 {
			header_up -X-Real-IP
		}
	}
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}

# The live preview (ADR 0032), on an origin of its own, since a page there is written by
# an editor and this host holds a token. Its gate decides all of what it answers.
:{$KONZILO_PORT_PREVIEW} {
	reverse_proxy 127.0.0.1:4000 {
		flush_interval -1
		header_up -X-Real-IP
	}
}

# Forgejo, closed at the proxy but for what signing in, saving and media need
# (ADR 0007). No Forgejo setting turns tokens off, so this is the one place to do it,
# and it stands from the first start, since a token made before it goes on working.
:{$KONZILO_PORT_GIT} {
	# First, and inside a handle: Caddy runs `handle` before a bare `respond`.
	@refused path_regexp (?i)^/api/v1/(users/[^/]+/tokens|user/applications|user/keys|user/gpg_keys)
	handle @refused {
		respond 404
	}

	@open {
		path /user/login /user/login/* /user/two_factor /user/two_factor/* /user/webauthn /user/webauthn/* /user/logout
		path /user/forgot_password /user/recover_account
		path /user/settings/security /user/settings/security/*
		path /login/oauth/* /assets/* /avatars/* /api/v1/* /api/forgejo/* /api/healthz
	}
	handle @open {
		reverse_proxy forgejo:3000 {
			header_up -X-Real-IP
		}
	}

	@repository path_regexp ^/{$KONZILO_REPOSITORY}(\.git/info/lfs|/media|/raw)/
	handle @repository {
		reverse_proxy forgejo:3000 {
			header_up -X-Real-IP
		}
	}

	handle {
		respond 404
	}
}
